# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# ── Auth ─────────────────────────────────────────────
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=7d

# ── PostgreSQL (users, chats, memberships) ─────────────
DATABASE_URL=postgres://chat:chat@localhost:5432/chat
# Set to true for hosted databases reached over an external URL (TLS required)
DATABASE_SSL=false

# ── Firebase / Firestore (messages, read receipts, last seen) ──
FIREBASE_PROJECT_ID=chat-local
# Option A: local emulator (docker compose up firestore). Leave the creds below empty.
FIRESTORE_EMULATOR_HOST=localhost:8080
# Option B: real project — either point to a service-account file…
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# …or inline the credentials (keep the \n escapes in the key).
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
