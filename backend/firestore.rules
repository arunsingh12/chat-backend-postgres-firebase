rules_version = '2';

// Messages, read receipts and last-seen pointers are written exclusively by
// the API through the Admin SDK (which bypasses these rules). Direct client
// access is denied so membership checks in PostgreSQL can't be sidestepped.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
